# ---------------------------------------------------------------------------
# VERDICT — example environment file.  Copy to `.env` and fill in real keys.
# All providers below have FREE tiers (no credit card required to start).
# Leave a key blank to skip that provider; the judge factory adapts.
# NOTE: never commit a real key. Keep real secrets in `.env` (gitignored).
# ---------------------------------------------------------------------------

# --- Active 3-judge design: genuinely payment-free, no card required ---
OPENROUTER_API_KEY=         # openrouter.ai/keys (free, no card)  -> cohere/north-mini-code:free + poolside/laguna-xs-2.1:free
MISTRAL_API_KEY=            # console.mistral.ai -> API Keys (free Experiment plan)  -> open-mistral-nemo

# --- Optional / fallback providers (NOT required; some need payment or hit quota limits) ---
HF_API_KEY=                 # huggingface.co/settings/tokens (fine-grained, "Inference Providers")  -> Gemma-3-27B (free tier quota often exhausted)
CEREBRAS_API_KEY=           # cloud.cerebras.ai -> API Keys                                          -> gpt-oss-120b (REQUIRES a payment method on file)
TOGETHER_API_KEY=           # api.together.ai (free credits + '-Free' models)   -> Llama-3.3-70B-Turbo-Free (Meta)
SAMBANOVA_API_KEY=          # cloud.sambanova.ai (used only if CEREBRAS_API_KEY is unset)
GROQ_API_KEY=               # console.groq.com -> Model Access (supplementary)  -> llama-3.1-8b-instant
GEMINI_API_KEY=             # aistudio.google.com/app/apikey (emergency single-judge fallback)

# --- Optional cost normalisation for benchmark outputs (0 = report cost as 0.0) ---
GEMINI_INPUT_USD_PER_MILLION_TOKENS=0
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=0

# ---------------------------------------------------------------------------
# Path overrides (read by src/config.py).  Leave UNSET for normal local runs —
# defaults resolve to the repo's own datasets/ folder.  Set these to redirect
# outputs to Google Drive in Colab (the Colab notebook sets them automatically).
# ---------------------------------------------------------------------------
# VERDICT_DATA_DIR=/content/drive/MyDrive/VERDICT/datasets
# VERDICT_OUTPUT_DIR=/content/drive/MyDrive/VERDICT/results
# VERDICT_FIGURES_DIR=/content/drive/MyDrive/VERDICT/charts
# VERDICT_ADVERSARIAL_DIR=/content/drive/MyDrive/VERDICT/raw_outputs/adversarial
# VERDICT_BENCHMARK_FILE=/content/drive/MyDrive/VERDICT/datasets/benchmark/securityeval_dataset.json
# VERDICT_SEED_FILE=/content/drive/MyDrive/VERDICT/datasets/benchmark/seed_dataset.json
