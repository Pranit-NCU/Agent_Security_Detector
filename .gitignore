.venv/
.pytest_cache/
pytest-cache-files-*/
__pycache__/
.coverage
*.pyc
.env

# Per-run experiment artefacts. These are rewritten by EVERY execution of
# experiments/run_all.py (including --mock runs), so committing them would put
# numbers in version control that contradict the pinned summary and the README.
# The citable figures live in results/final_run_results.json — see results/README.md.
datasets/processed/*.json
datasets/processed/*.md
datasets/processed/figures/

# Judge caches are large, machine-specific, and regenerable.
**/judge_cache*.json

# Colab notebook backups
notebooks/*.bak.ipynb
